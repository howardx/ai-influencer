{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "soul-sheet.v1.schema.json",
  "title": "Soul sheet v1",
  "description": "Persona definition consumed by the persona agent and edited in the app. This file is the language-neutral source of truth (spec §5): JS validates it directly, a future Go/other agent generates types from it. Semantic rules JSON Schema cannot express (pillar weights sum to 1, unique pillar names, postsPerDay[min] <= [max]) live in validate.js next to this file — port them alongside any type generation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "personaId", "ownerId", "identity", "voice", "worldview", "contentPillars", "boundaries", "rhythm"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "personaId": { "type": "string", "minLength": 1 },
    "ownerId": { "type": "string", "minLength": 1 },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "timezone"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "age": { "type": "integer", "minimum": 18, "maximum": 99 },
        "city": { "type": "string" },
        "occupation": { "type": "string" },
        "backstory": { "type": "string", "maxLength": 800, "description": "3–5 sentences max" },
        "timezone": { "type": "string", "minLength": 1, "description": "IANA zone, e.g. America/Los_Angeles — drives the scheduler" }
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style", "never_sounds_like", "examplePosts"],
      "properties": {
        "tone": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "style": { "type": "string", "minLength": 1 },
        "catchphrases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "never_sounds_like": {
          "type": "string",
          "minLength": 1,
          "description": "Negative space carries the voice — positive tone adjectives alone regress to AI-flavored engagement-speak"
        },
        "examplePosts": {
          "type": "array",
          "minItems": 5,
          "maxItems": 10,
          "items": { "type": "string", "minLength": 1, "maxLength": 280 },
          "description": "5–10 in-voice anchors — the few-shot core"
        }
      }
    },
    "worldview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "opinions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["topic", "stance"],
            "properties": {
              "topic": { "type": "string", "minLength": 1 },
              "stance": { "type": "string", "minLength": 1 },
              "strength": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "interests": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "dislikes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "contentPillars": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "description": "Closed set by design: no commercial/promo pillar exists, so the mixer is structurally unable to schedule promos (spec §2 non-goal)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "weight", "media"],
        "properties": {
          "name": { "enum": ["photo drop", "gym take", "daily-life texture", "trend opinion"] },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 },
          "media": { "enum": ["always", "sometimes", "rarely", "never"] },
          "queueGated": { "type": "boolean" }
        },
        "if": { "properties": { "name": { "const": "trend opinion" } } },
        "then": { "required": ["queueGated"], "properties": { "queueGated": { "const": true } } }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bannedTopics", "disclosure", "neverDo"],
      "properties": {
        "bannedTopics": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "disclosure": {
          "type": "string",
          "minLength": 1,
          "description": "AI-character disclosure — bio label + X automated-account flag. Required: compliance posture is non-negotiable (spec §8)"
        },
        "neverDo": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "rhythm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activeHours", "postsPerDay", "replyBudgetPerDay"],
      "properties": {
        "activeHours": { "type": "string", "minLength": 1, "description": "e.g. \"07:00–23:30 local, quiet 13:00–15:00\"" },
        "postsPerDay": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "integer", "minimum": 0, "maximum": 10 },
          "description": "[min, max] — daily count sampled from this range; cap is a ban-safety dial"
        },
        "replyBudgetPerDay": { "type": "integer", "minimum": 0, "maximum": 25 }
      }
    },
    "seedArc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "currentArc": { "type": "string" },
        "runningBits": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "description": "Seed only — after first load the agent's arc_state table owns this"
    }
  }
}
