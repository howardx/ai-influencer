# Persona agent configuration — copy to agent/.env for local dev and load
# with `npx tsx --env-file=.env src/index.ts`. In production this content
# lives in /etc/persona-agent/env (systemd EnvironmentFile), mode 600.
#
# SECRETS NEVER GO IN THE REPO OR THE BROWSER APP (spec §4 trust boundary).
# None of these are needed for `npm run smoke` — DemoAdapter runs dry.

# Where SQLite files and the media library live (created on first run)
AGENT_DATA_DIR=./data

# Soul sheet for the persona (exported from the app's Personality page)
SOUL_SHEET=../shared/soul-sheet/kayla.example.json

# Telegram approval queue (HEX-24)
#TELEGRAM_BOT_TOKEN=

# Claude drafting + critic (HEX-23)
#ANTHROPIC_API_KEY=

# X API v2 user-context OAuth (HEX-18/HEX-22). Scopes are deliberately
# limited to tweet.read tweet.write users.read offline.access —
# the agent structurally cannot like/follow/DM.
#X_CLIENT_ID=
#X_ACCESS_TOKEN=
#X_REFRESH_TOKEN=
