# Persona agent configuration — copy to agent/.env for local dev and load
# with `npx tsx --env-file=.env src/index.ts`. In production this content
# lives in /etc/persona-agent/env (systemd EnvironmentFile), mode 600.
#
# SECRETS NEVER GO IN THE REPO OR THE BROWSER APP (spec §4 trust boundary).
# None of these are needed for `npm run smoke` — DemoAdapter runs dry.

# Where SQLite files and the media library live (created on first run)
AGENT_DATA_DIR=./data

# Soul sheet for the persona (exported from the app's Personality page)
SOUL_SHEET=../shared/soul-sheet/kayla.example.json

# Telegram approval queue (HEX-24): token from @BotFather; chat id of your
# DM with the bot (message it once, then GET /getUpdates shows chat.id — or
# ask @userinfobot). LOG_CHAT_ID: optional muted channel for auto-publish
# mirrors with 🗑 delete; defaults to TELEGRAM_CHAT_ID.
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=
#TELEGRAM_LOG_CHAT_ID=

# Claude drafting + critic (HEX-23); model defaults to claude-sonnet-5
#ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=

# Force DemoAdapter even when X credentials exist (demo rehearsal / dev)
#DEMO_MODE=1
# Which stored persona (data/accounts.json) this daemon runs — needed only
# when several accounts are stored
#X_PERSONA_HANDLE=

# X API v2 user-context OAuth (HEX-18/HEX-22). Scopes are deliberately
# limited to tweet.read tweet.write users.read media.write offline.access —
# the agent structurally cannot like/follow/DM.
#
# From the developer portal (App → Keys and tokens → OAuth 2.0). These are
# APP-level: one pair forever, no matter how many personas authorize it.
#X_CLIENT_ID=
#X_CLIENT_SECRET=
#
# Per-persona access/refresh tokens do NOT live here — `tools/x-oauth.ts`
# writes them to $AGENT_DATA_DIR/accounts.json (one entry per persona,
# mode 600) and rotations save themselves. Legacy X_ACCESS_TOKEN vars are
# still read by src/config.ts for the single-persona engine path.
